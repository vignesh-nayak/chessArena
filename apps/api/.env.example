# Copy to .env and fill in real values. Never commit .env.
# The URI does not select the database. NODE_ENV=production uses "prod";
# anything else, including local dev, uses "test".

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Comma-separated allowed origins. Trailing slashes are stripped. `*` is rejected.
CORS_ORIGIN=http://localhost:5173
PORT=4000
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-different-long-random-string
