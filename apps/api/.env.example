# Copy to .env and fill in real values. Never commit .env.

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/chessarena?retryWrites=true&w=majority
# Comma-separated allowed origins. Trailing slashes are stripped. `*` is rejected.
CORS_ORIGIN=http://localhost:5173
PORT=4000
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-different-long-random-string
